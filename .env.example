# Copy this file to ".env" for LOCAL development only.
# Never commit your real .env to GitHub.

# Local SQLite (default setup — works on your machine, not on Vercel)
DATABASE_URL="file:../db/custom.db"

# For a Vercel + Neon leaderboard, use the Postgres provider in
# prisma/schema.prisma and paste your Neon connection string instead:
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
